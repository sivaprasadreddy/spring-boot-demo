### Create Post
POST http://localhost:8080/api/posts
Content-Type: application/json
#Authorization: Basic admin@gmail.com password
#Authorization: Bearer {{auth_token}}

{
  "title": "Spring Boot Tips",
  "slug": "spring-boot-tips",
  "content": "Here are my top 10 Spring Boot Tips"
}


> {%
    client.test("Create post request executed successfully", function () {
        client.assert(response.status === 201, "Response status is not 201");
    });
%}

### Update Post
PUT http://localhost:8080/api/posts/spring-boot-tips
Content-Type: application/json
Authorization: Basic admin@gmail.com password
#Authorization: Bearer {{auth_token}}

{
  "title": "Spring Boot Top 10 Tips",
  "slug": "spring-boot-top10-tips",
  "content": "My top 10 Spring Boot Tips"
}

> {%
    client.test("Update post request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}
